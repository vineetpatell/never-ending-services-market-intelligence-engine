# Example environment — PLACEHOLDERS ONLY. Never commit real credentials.
# Copy to `.env` (git-ignored) when a phase actually needs it.

# Runtime mode: development | test | production
APP_ENV=development

# Frontend origin (Vite dev server)
FRONTEND_URL=http://127.0.0.1:5173

# Local backend base URL (applies from the backend phase onward; nothing listens here yet)
API_BASE_URL=http://127.0.0.1:8000

# Local backend base URL for the frontend (Vite-exposed)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Local database connection (SQLite file path; created in a later phase)
DATABASE_URL=sqlite:///./data/app.sqlite3

# Market data provider selector. `demo` = synthetic fixtures only.
# A real provider value requires a documented doc-11 evaluation + ADR first.
MARKET_PROVIDER=demo

# Optional local model endpoint (Phase M7 only; leave empty until approved)
LOCAL_MODEL_URL=
